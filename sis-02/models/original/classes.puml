@startuml
class Student {
  studentId : String
}
class Course {
  courseCode : String
  title : String
}
class CourseOffering {
  offeringId : String
  semester : String
  capacity : Integer
}
class Enrollment {
  enrollmentId : String
}
Course "1" -- "0..*" CourseOffering : is scheduled as >
Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : has >
@enduml
