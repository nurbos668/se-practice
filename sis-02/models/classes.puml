@startuml
hide empty methods
skinparam classAttributeIconSize 0

class Student {
  studentId : String
}

class Course {
  courseCode : String
  title : String
}

class CourseOffering {
  offeringId : String
  semester : String
  capacity : Integer
  /availablePlaces : Integer
}

class Enrollment {
  enrollmentId : String
}

Course "1" -- "0..*" CourseOffering : is scheduled as >
Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : has >

note right of CourseOffering
  {capacity >= 1}  (whole number, given)
  {number of Enrollments <= capacity}  (R2)
  /availablePlaces = capacity - number of Enrollments
  semester is a label such as "Fall 2026"
end note

note bottom of Enrollment
  {unique (student, offering)}  (R3)
  At most one Enrollment per student
  and offering.
end note
@enduml
